# Copy to .env and fill in. Every variable here is validated at boot by
# src/config/env.schema.ts — a missing or malformed value fails startup with a
# named error rather than failing request #4000.

# development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL connection string (docker-compose.yml provisions this locally)
DATABASE_URL=postgresql://evergrove:evergrove@localhost:5432/evergrove?schema=public

# --- Access tokens ------------------------------------------------------------
# Authentication is a single signed JWT sent as `Authorization: Bearer`. There
# is no refresh token, no session table and no revocation: when it expires the
# user signs in again. Its lifetime is therefore the only bound on a compromise.

# HS256 signing key. REQUIRED — there is no default, and startup fails without
# it. Never commit a real value; generate a fresh one per environment with:
#   openssl rand -base64 48
JWT_SECRET=v3ryS3cr3tJs3cr3tWK3yF0rT3st1nTgOnl

# Token lifetime, and how long a user stays signed in. 8 hours covers a working
# day. Shortening it is the lever to pull during an incident; lengthening it
# lengthens the window a stolen token stays usable by exactly as much.
JWT_ACCESS_TTL_MS=28800000

# Claims every token is signed with and every token is verified against. A token
# minted for another issuer or another audience is rejected even if the
# signature is valid.
JWT_ISSUER=evergrove
JWT_AUDIENCE=evergrove-web

# --- Transport ----------------------------------------------------------------

# Comma-separated allowlist of browser origins permitted to call the API.
# Development only: in production the SPA reaches the API through the Netlify
# /api/* rewrite, which makes every call same-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per IP.
# The tighter limit on credential endpoints is deliberately NOT configurable —
# see src/common/constants/auth.constants.ts.
THROTTLE_TTL_MS=900000
THROTTLE_LIMIT=300

# Maximum accepted request body size
BODY_LIMIT=100kb
