# Copy to .env and fill in. Every variable here is validated at boot by
# src/config/env.schema.ts — a missing or malformed value fails startup with a
# named error rather than failing request #4000.

# development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL connection string (docker-compose.yml provisions this locally)
DATABASE_URL=postgresql://evergrove:evergrove@localhost:5432/evergrove?schema=public

# --- Access tokens ------------------------------------------------------------
# Authentication is two credentials (ADR-008 rev. 3): this signed JWT, sent as
# `Authorization: Bearer` and held in the client's memory, plus a rotating
# refresh token in an HttpOnly cookie (below). The access half stays stateless —
# nothing on the request path reads a session row — so this lifetime is still the
# only bound on a stolen *access* token. Revoking a session stops it being
# renewed, not being used, which is why the lifetime below is short.

# HS256 signing key. REQUIRED — there is no default, and startup fails without
# it. Never commit a real value; generate a fresh one per environment with:
#   openssl rand -base64 48
JWT_SECRET=v3ryS3cr3tJs3cr3tWK3yF0rT3st1nTgOnl

# Access-token lifetime — NOT how long a user stays signed in; the refresh cookie
# decides that. This is how long a stolen token stays usable, and how long a
# revoked session's last access token keeps working. Must be shorter than
# SESSION_IDLE_TTL_MS; startup fails otherwise.
JWT_ACCESS_TTL_MS=900000

# Claims every token is signed with and every token is verified against. A token
# minted for another issuer or another audience is rejected even if the
# signature is valid.
JWT_ISSUER=evergrove
JWT_AUDIENCE=evergrove-web

# --- Refresh sessions ---------------------------------------------------------
# The revocable half. An opaque 32-byte token in an HttpOnly, SameSite=Lax cookie
# scoped to /api/v1/auth, stored only as a SHA-256 digest and rotated on every
# use. This is what lets a reload resume a session, and what makes `logout` and
# `change-password` actually revoke something.
#
# Three things are deliberately NOT configurable here, because they are security
# policy rather than operational knobs: the cookie's Path and Secure flag
# (src/common/utils/cookies.ts) and the refresh throttle
# (src/common/constants/auth.constants.ts).

# The cookie's name. Changing it in a running deployment signs everyone out.
SESSION_COOKIE_NAME=evergrove_session

# Sliding idle window: how long an unused session survives. Every refresh pushes
# it forward — but never past the ceiling below.
SESSION_IDLE_TTL_MS=604800000

# Hard cap on a login chain, inherited by every rotated successor. Without that
# inheritance a client refreshing often enough would extend its session forever,
# and this value would be decorative. Must be >= SESSION_IDLE_TTL_MS.
SESSION_ABSOLUTE_TTL_MS=2592000000

# --- Transport ----------------------------------------------------------------

# Comma-separated allowlist of browser origins permitted to call the API.
# Development only: in production the SPA reaches the API through the Netlify
# /api/* rewrite, which makes every call same-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per IP.
# The tighter limit on credential endpoints is deliberately NOT configurable —
# see src/common/constants/auth.constants.ts.
THROTTLE_TTL_MS=900000
THROTTLE_LIMIT=300

# Maximum accepted request body size
BODY_LIMIT=100kb
