// Evergrove backend — Prisma schema.
//
// Scope: identity, preferences, and the timer. Per the approved data model, `users` holds identity
// and credentials — facts the user asserts that the system cannot derive. Everything derived,
// high-frequency, or rebuildable lives elsewhere: preferences in `user_settings`, work in `tasks`,
// history in the `focus_sessions` event log, and progression in the `user_gamification` projection.
//
// `focus_sessions` was called `timer_intervals` in this comment while every index and constraint in
// the architecture document named it `focus_sessions`. The table is `focus_sessions`.
//
// There is no session table. Authentication is a self-contained signed token that the server
// keeps no record of, so a sign-in writes nothing but `last_login_at`.
//
// The connection URL lives in ../prisma.config.ts (Prisma 7 no longer accepts `url` here).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// An account. Identity and credentials only — never points, titles, settings or counters.
model User {
  /// UUIDv7: time-ordered, so index locality on insert is sequential rather than random.
  /// Not a sequence — ids appear in URLs and exports, where they would leak the user count.
  id String @id @default(uuid(7)) @db.Uuid

  /// Normalised to trim+lowercase at the DTO boundary; a CHECK constraint pins the invariant.
  email String @unique @db.VarChar(320)

  /// The handle as the user typed it (trimmed). Rendered publicly as `@username`.
  username String @db.VarChar(20)

  /// lower(username). Carries the UNIQUE index so uniqueness is case-insensitive without the
  /// `citext` extension ADR-003 rejected. Maintained in the repository AND by a CHECK
  /// constraint, so no writer can desynchronise it from `username`.
  usernameLower String @unique @map("username_lower") @db.VarChar(20)

  firstName String @map("first_name") @db.VarChar(50)
  lastName  String @map("last_name") @db.VarChar(50)

  /// Argon2id encoded string — carries its own salt and parameters, so no salt/algo columns.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// IANA zone name. Load-bearing: every stored instant for this account is read through it.
  timezone String @default("UTC") @db.VarChar(64)

  /// Ships nullable and unused, so email verification is later a pure addition rather than a
  /// behavioural migration. Nothing may gate on it until that flow exists.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  /// Audit only. Authentication is stateless (ADR-008), so nothing consults this to invalidate a
  /// token — it records *when* the credential changed, for a future security panel.
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)

  /// The only record that a sign-in happened, now that sessions are not persisted at all.
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  /// When the avatar last changed, or null when there is none. Denormalised from `user_avatars`
  /// and written in the same transaction, so the hot path can answer "has a photo, is it fresh?"
  /// without ever loading the bytes.
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  avatar       UserAvatar?
  settings     UserSettings?
  tasks        Task[]
  sessions     FocusSession[]
  gamification UserGamification?

  @@map("users")
}

/// A profile photo, stored as bytes in Postgres (ADR-015 rev. 2).
///
/// Deliberately its own table rather than columns on `users`: JwtGuard reads the user row on every
/// authenticated request, so bytes living there would be loaded by every call the application ever
/// makes. Nothing reads this table except the one endpoint that serves the image.
model UserAvatar {
  userId String @id @map("user_id") @db.Uuid

  /// Bounded above the database — multer refuses the upload past 256 KB and the domain re-checks.
  data Bytes

  contentType String @map("content_type") @db.VarChar(32)
  byteSize    Int    @map("byte_size")
  width       Int    @db.SmallInt
  height      Int    @db.SmallInt

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// An account's preferences (CONTRACT.md §1.4).
///
/// The row is lazy: reading returns domain defaults when it is absent, and only a write creates it.
/// So registration is untouched and every account that predates this table works without a backfill.
///
/// Scalars that have rules and that other features will eventually query are columns; the
/// appearance blob is JSONB, which is the whole of ADR-003's "JSONB only for genuinely schemaless
/// preferences" escape hatch. Zod validates the blob's shape on every write — Postgres does not.
///
/// Like `user_avatars`, this is deliberately not columns on `users`: JwtGuard reads the user row on
/// every authenticated request, and preferences are needed by exactly one page.
model UserSettings {
  userId String @id @map("user_id") @db.Uuid

  workMinutes  Int    @default(25) @map("work_minutes") @db.SmallInt
  breakMinutes Int    @default(5) @map("break_minutes") @db.SmallInt
  theme        String @default("system") @db.VarChar(16)

  /// `customTheme`, `background` and `labels`. Merged key-wise on write, so two sections saving
  /// at once accumulate rather than overwrite each other.
  preferences Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// A unit of work a focus session can be run against (CONTRACT.md §13.1).
///
/// `status` is 'todo' | 'completed' | 'abandoned', pinned by a CHECK constraint. There is no
/// 'expired' and no 24-hour expiry: real work spans days, and silently expiring an unfinished task
/// overnight is a mechanic that annoys rather than motivates.
///
/// A task is *abandoned*; a session is *terminated*. They are different nouns for different things,
/// and only an explicit user action moves a task between statuses — never a timer event.
///
/// Deletion is hard deletion. There is no `deleted_at`: a soft-deleted task would linger in the
/// task-outcome chart forever, so the user's own statistics would keep counting work they
/// explicitly erased. Sessions survive it through their title snapshot.
model Task {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title  String @db.VarChar(120)
  status String @default("todo") @db.VarChar(16)

  /// Ships nullable and unwritten by any UI — it is the estimation-calibration feature's column,
  /// added now so that feature is a pure addition rather than a migration.
  estimatedPomodoros Int? @map("estimated_pomodoros") @db.SmallInt

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions FocusSession[]

  /// Deliberately NOT partial on `status = 'todo'`. Hydration fetches every status so History can
  /// break down task outcomes, and a partial index would not serve that read.
  @@index([userId, createdAt(sort: Desc)])
  @@map("tasks")
}

/// A finished focus or break interval. THE EVENT LOG — append-only and immutable (ADR-006).
///
/// There is no update path and no delete path: no `PATCH /sessions/:id` exists and none will. A
/// correction would be a compensating record, not an edit. This table is the single source of truth
/// from which History and every analytic are derived, which is only safe if nothing rewrites it.
///
/// Two columns are easy to get wrong:
///   - `actualDurationMs` is CLIENT-REPORTED and then clamped, NOT `ended_at - started_at`. Pause
///     exists, so a block paused for an hour has a 25-minute actual and an 85-minute span. A CHECK
///     constraint stops the reported value exceeding the wall clock.
///   - `taskTitleSnapshot` is CLIENT-SUPPLIED and stored verbatim, never derived from the `tasks`
///     row. It is the title as the user saw it while focusing, so deleting or renaming the task
///     afterwards cannot rewrite what the history says.
model FocusSession {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  taskId String? @map("task_id") @db.Uuid

  taskTitleSnapshot String @map("task_title_snapshot") @db.VarChar(120)

  /// The client's own primary key, minted when the block starts. The outbox idempotency key.
  clientSessionId String @map("client_session_id") @db.Uuid

  type   String @db.VarChar(8)
  status String @db.VarChar(16)

  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime @map("ended_at") @db.Timestamptz(3)
  /// Server receive time. Audit only — the attribution decision it fed is stored below.
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  /// The user-local calendar day this record counts toward, decided once at insert.
  ///
  /// Stored rather than recomputed, for three reasons. It makes replaying the log deterministic,
  /// which is the property the whole projection rests on. It means a rebuild needs no access to the
  /// users table, so the timer owns its own data end to end. And it means changing your timezone
  /// does not silently rewrite which day last month's work happened on — the day you lived through
  /// is a fact, not a view.
  attributionDate DateTime @map("attribution_date") @db.Date

  plannedDurationMs Int @map("planned_duration_ms")
  actualDurationMs  Int @map("actual_duration_ms")

  terminationReason String? @map("termination_reason") @db.VarChar(20)
  pointsAwarded     Int     @default(0) @map("points_awarded")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// A retried outbox flush is success, not a conflict — this is what makes it so.
  @@unique([userId, clientSessionId])
  /// A genuine double-tap, or two devices claiming the same instant. This one IS a conflict.
  @@unique([userId, startedAt])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, taskId])
  @@map("focus_sessions")
}

/// Progression totals. A PROJECTION, not a source of truth (ADR-006).
///
/// Every column here is derivable by replaying `focus_sessions` in order, which is what the
/// `gamification:rebuild` command does. If this row is ever wrong, it is rebuilt rather than
/// patched — and the fact that it CAN be rebuilt is what allows it to be updated in the same
/// transaction as the insert without that being a durability risk.
model UserGamification {
  userId String @id @map("user_id") @db.Uuid

  /// Equal to `lifetimePoints` for as long as no rule subtracts. Kept separate so a spending sink
  /// can arrive without a migration; the UI renders lifetime.
  balance        Int @default(0)
  lifetimePoints Int @default(0) @map("lifetime_points")

  /// Consecutive calendar days with a completed focus session — the streak the UI displays.
  currentDayStreak Int @default(0) @map("current_day_streak")
  longestDayStreak Int @default(0) @map("longest_day_streak")

  /// Consecutive completed focus sessions. Internal to the economy: it fires the +50 every third
  /// session and resets on a termination. Never displayed as "your streak".
  currentSessionRun Int @default(0) @map("current_session_run") @db.SmallInt

  /// The user-local date of the last completed focus session. Drives lazy streak resolution, so no
  /// scheduled job is needed to expire a streak.
  lastActiveDate DateTime? @map("last_active_date") @db.Date

  /// Ships with a value that nothing reads yet, so the freeze feature is later pure logic.
  streakFreezesAvailable Int       @default(1) @map("streak_freezes_available") @db.SmallInt
  lastFreezeGrantedOn    DateTime? @map("last_freeze_granted_on") @db.Date

  unlockedTitles String[] @default([]) @map("unlocked_titles")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_gamification")
}
