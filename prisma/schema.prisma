// Evergrove backend — Prisma schema.
//
// Scope: identity, preferences, and the timer. Per the approved data model, `users` holds identity
// and credentials — facts the user asserts that the system cannot derive. Everything derived,
// high-frequency, or rebuildable lives elsewhere: preferences in `user_settings`, work in `tasks`,
// history in the `focus_sessions` event log, and progression in the `user_gamification` projection.
//
// `focus_sessions` was called `timer_intervals` in this comment while every index and constraint in
// the architecture document named it `focus_sessions`. The table is `focus_sessions`.
//
// Authentication is two credentials (ADR-008 rev. 3): a short signed access token the server keeps
// no record of, and a rotating opaque refresh token that `auth_sessions` *is* the record of. The
// access half is still stateless — `JwtGuard` verifies a signature and never reads a row — so the
// session table bounds a compromise rather than closing it. A sign-in writes `last_login_at` and one
// `auth_sessions` row.
//
// The connection URL lives in ../prisma.config.ts (Prisma 7 no longer accepts `url` here).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// An account. Identity and credentials only — never points, titles, settings or counters.
model User {
  /// UUIDv7: time-ordered, so index locality on insert is sequential rather than random.
  /// Not a sequence — ids appear in URLs and exports, where they would leak the user count.
  id String @id @default(uuid(7)) @db.Uuid

  /// Normalised to trim+lowercase at the DTO boundary; a CHECK constraint pins the invariant.
  email String @unique @db.VarChar(320)

  /// The handle as the user typed it (trimmed). Rendered publicly as `@username`.
  username String @db.VarChar(20)

  /// lower(username). Carries the UNIQUE index so uniqueness is case-insensitive without the
  /// `citext` extension ADR-003 rejected. Maintained in the repository AND by a CHECK
  /// constraint, so no writer can desynchronise it from `username`.
  usernameLower String @unique @map("username_lower") @db.VarChar(20)

  firstName String @map("first_name") @db.VarChar(50)
  lastName  String @map("last_name") @db.VarChar(50)

  /// Argon2id encoded string — carries its own salt and parameters, so no salt/algo columns.
  ///
  /// Nullable since ADR-008a. Null means the account was created through a provider and has never
  /// set a password. Every path that verifies a password must treat null as "no password will ever
  /// match" **and still pay the dummy-verify cost**, or the login endpoint starts answering faster
  /// for provider-only accounts and becomes an enumeration oracle.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  /// IANA zone name. Load-bearing: every stored instant for this account is read through it.
  timezone String @default("UTC") @db.VarChar(64)

  /// Written by a verified Google sign-in (ADR-008a) — the first and only writer. Still **read** by
  /// nothing: no guard, route or rule gates on it, and none may until the verification flow exists.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  /// Audit only, still. Changing a password now revokes every other `auth_sessions` row (ADR-008
  /// rev. 3), so "sign out my other devices" is enforced by *deleting the sessions*, not by
  /// comparing this column against a token's `iat`. No guard reads it. It records *when* the
  /// credential changed, for a future security panel.
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)

  /// When the user last presented a password. Distinct from `auth_sessions.created_at`, which
  /// records the same event per session — this is the account-level answer, and it survives the
  /// session being revoked or expiring.
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  /// When the avatar last changed, or null when there is none. Denormalised from `user_avatars`
  /// and written in the same transaction, so the hot path can answer "has a photo, is it fresh?"
  /// without ever loading the bytes.
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  avatar       UserAvatar?
  settings     UserSettings?
  tasks        Task[]
  sessions     FocusSession[]
  gamification UserGamification?
  authSessions       AuthSession[]
  identities         AuthIdentity[]
  reportSubscription ReportSubscription?

  @@map("users")
}

/// An external identity that can prove ownership of an Evergrove account (ADR-008a).
///
/// The credential is the provider's assertion, and `provider_subject` — never the email — is the
/// identity. Emails change at the provider, and re-resolving by email would hand an account to
/// whoever holds the old address next. That is why `email_at_link` below is audit material and is
/// never a lookup key.
///
/// This table is the *identity-proof* layer only. It issues nothing and stores no provider token:
/// the authorization request asks for `access_type=online`, so Google returns no refresh token, and
/// the access token from the exchange is discarded with the response object. A session still means
/// exactly what ADR-008 rev. 3 says it means — `auth_sessions`, reached through the same
/// `startSession()` the password path uses.
model AuthIdentity {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// 'google'. VarChar + CHECK rather than a Prisma enum, matching this schema's existing refusal
  /// of them: adding a provider must be a migration someone reads, not a generated type change.
  provider String @db.VarChar(32)

  /// The OIDC `sub` claim. Opaque, immutable, and unique within the provider.
  providerSubject String @map("provider_subject") @db.VarChar(255)

  /// The address the provider asserted when the link was made. Audit only — never authoritative,
  /// never a lookup key, and deliberately not kept in step with either side afterwards.
  emailAtLink String? @map("email_at_link") @db.VarChar(320)

  linkedAt    DateTime  @default(now()) @map("linked_at") @db.Timestamptz(3)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The sign-in lookup, and the guarantee that one Google account cannot reach two Evergrove ones.
  /// Named explicitly: Prisma would derive `..._provider_provider_subject_key`, and the migration
  /// creates the shorter name — leaving it implicit would report drift on the next `migrate dev`.
  @@unique([provider, providerSubject], map: "auth_identities_provider_subject_key")
  /// At most one identity per provider per account. Named for the same reason.
  @@unique([userId, provider], map: "auth_identities_user_provider_key")
  @@index([userId])
  @@map("auth_identities")
}

/// A refresh session — the revocable half of the credential pair (ADR-008 rev. 3).
///
/// Reinstates the table `20260729120000_drop_auth_sessions` destroyed. Nothing on the request path
/// reads it: `JwtGuard` verifies a signature and stops there, so an access token stays valid for its
/// full 15 minutes no matter what happens here. This table bounds a compromise; it does not close
/// one. What it buys is that `logout` and `change-password` mean something again.
///
/// Note the name. A *focus* session is a pomodoro interval (`focus_sessions`); an *auth* session is
/// a login. They are unrelated, and the repositories are deliberately named apart.
model AuthSession {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the opaque cookie value — 32 raw bytes, so `Bytes` rather than a hex string. The
  /// plaintext exists only in the browser's cookie jar, which is why a dump of this table is not a
  /// set of usable sessions. UNIQUE is both the lookup path and the collision guard.
  tokenHash Bytes @unique @map("token_hash")

  /// The sliding idle window, pushed forward on every rotation — but never past the ceiling below.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// The hard cap, and **inherited by every rotated successor**. Without that inheritance a client
  /// refreshing every 15 minutes would push the 30-day limit forward forever, which is to say there
  /// would be no limit. This column is the whole reason the cap is real.
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)

  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)

  /// Set on rotation and on logout — and the row is **kept**, never deleted. That is what makes a
  /// replayed token distinguishable from an unknown one: an unknown hash matches nothing, while a
  /// replayed one matches a revoked row, which is a theft signal rather than a typo.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// Forensics only, and the only trail a compromised session leaves. Free to capture at insert.
  userAgent String? @map("user_agent") @db.VarChar(512)
  ip        String? @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Revoke-all-for-user, on password change and on reuse detection.
  @@index([userId])
  /// Serves the opportunistic purge on login. Since `expires_at <= absolute_expires_at` always,
  /// sweeping on the idle window is an index-driven superset of the genuinely dead rows.
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// A profile photo, stored as bytes in Postgres (ADR-015 rev. 2).
///
/// Deliberately its own table rather than columns on `users`: JwtGuard reads the user row on every
/// authenticated request, so bytes living there would be loaded by every call the application ever
/// makes. Nothing reads this table except the one endpoint that serves the image.
model UserAvatar {
  userId String @id @map("user_id") @db.Uuid

  /// Bounded above the database — multer refuses the upload past 256 KB and the domain re-checks.
  data Bytes

  contentType String @map("content_type") @db.VarChar(32)
  byteSize    Int    @map("byte_size")
  width       Int    @db.SmallInt
  height      Int    @db.SmallInt

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// An account's preferences (CONTRACT.md §1.4).
///
/// The row is lazy: reading returns domain defaults when it is absent, and only a write creates it.
/// So registration is untouched and every account that predates this table works without a backfill.
///
/// Scalars that have rules and that other features will eventually query are columns; the
/// appearance blob is JSONB, which is the whole of ADR-003's "JSONB only for genuinely schemaless
/// preferences" escape hatch. Zod validates the blob's shape on every write — Postgres does not.
///
/// Like `user_avatars`, this is deliberately not columns on `users`: JwtGuard reads the user row on
/// every authenticated request, and preferences are needed by exactly one page.
model UserSettings {
  userId String @id @map("user_id") @db.Uuid

  workMinutes  Int    @default(25) @map("work_minutes") @db.SmallInt
  breakMinutes Int    @default(5) @map("break_minutes") @db.SmallInt
  theme        String @default("system") @db.VarChar(16)

  /// `customTheme`, `background` and `labels`. Merged key-wise on write, so two sections saving
  /// at once accumulate rather than overwrite each other.
  preferences Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// A unit of work a focus session can be run against (CONTRACT.md §13.1).
///
/// `status` is 'todo' | 'completed' | 'abandoned', pinned by a CHECK constraint. There is no
/// 'expired' and no 24-hour expiry: real work spans days, and silently expiring an unfinished task
/// overnight is a mechanic that annoys rather than motivates.
///
/// A task is *abandoned*; a session is *terminated*. They are different nouns for different things,
/// and only an explicit user action moves a task between statuses — never a timer event.
///
/// Deletion is hard deletion. There is no `deleted_at`: a soft-deleted task would linger in the
/// task-outcome chart forever, so the user's own statistics would keep counting work they
/// explicitly erased. Sessions survive it through their title snapshot.
model Task {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title  String @db.VarChar(120)
  status String @default("todo") @db.VarChar(16)

  /// Ships nullable and unwritten by any UI — it is the estimation-calibration feature's column,
  /// added now so that feature is a pure addition rather than a migration.
  estimatedPomodoros Int? @map("estimated_pomodoros") @db.SmallInt

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions FocusSession[]

  /// Deliberately NOT partial on `status = 'todo'`. Hydration fetches every status so History can
  /// break down task outcomes, and a partial index would not serve that read.
  @@index([userId, createdAt(sort: Desc)])
  @@map("tasks")
}

/// A finished focus or break interval. THE EVENT LOG — append-only and immutable (ADR-006).
///
/// There is no update path and no delete path: no `PATCH /sessions/:id` exists and none will. A
/// correction would be a compensating record, not an edit. This table is the single source of truth
/// from which History and every analytic are derived, which is only safe if nothing rewrites it.
///
/// Two columns are easy to get wrong:
///   - `actualDurationMs` is CLIENT-REPORTED and then clamped, NOT `ended_at - started_at`. Pause
///     exists, so a block paused for an hour has a 25-minute actual and an 85-minute span. A CHECK
///     constraint stops the reported value exceeding the wall clock.
///   - `taskTitleSnapshot` is CLIENT-SUPPLIED and stored verbatim, never derived from the `tasks`
///     row. It is the title as the user saw it while focusing, so deleting or renaming the task
///     afterwards cannot rewrite what the history says.
model FocusSession {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  taskId String? @map("task_id") @db.Uuid

  taskTitleSnapshot String @map("task_title_snapshot") @db.VarChar(120)

  /// The client's own primary key, minted when the block starts. The outbox idempotency key.
  clientSessionId String @map("client_session_id") @db.Uuid

  type   String @db.VarChar(8)
  status String @db.VarChar(16)

  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime @map("ended_at") @db.Timestamptz(3)
  /// Server receive time. Audit only — the attribution decision it fed is stored below.
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  /// The user-local calendar day this record counts toward, decided once at insert.
  ///
  /// Stored rather than recomputed, for three reasons. It makes replaying the log deterministic,
  /// which is the property the whole projection rests on. It means a rebuild needs no access to the
  /// users table, so the timer owns its own data end to end. And it means changing your timezone
  /// does not silently rewrite which day last month's work happened on — the day you lived through
  /// is a fact, not a view.
  attributionDate DateTime @map("attribution_date") @db.Date

  plannedDurationMs Int @map("planned_duration_ms")
  actualDurationMs  Int @map("actual_duration_ms")

  terminationReason String? @map("termination_reason") @db.VarChar(20)
  pointsAwarded     Int     @default(0) @map("points_awarded")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// A retried outbox flush is success, not a conflict — this is what makes it so.
  @@unique([userId, clientSessionId])
  /// A genuine double-tap, or two devices claiming the same instant. This one IS a conflict.
  @@unique([userId, startedAt])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, taskId])
  @@map("focus_sessions")
}

/// Progression totals. A PROJECTION, not a source of truth (ADR-006).
///
/// Every column here is derivable by replaying `focus_sessions` in order, which is what the
/// `gamification:rebuild` command does. If this row is ever wrong, it is rebuilt rather than
/// patched — and the fact that it CAN be rebuilt is what allows it to be updated in the same
/// transaction as the insert without that being a durability risk.
model UserGamification {
  userId String @id @map("user_id") @db.Uuid

  /// Equal to `lifetimePoints` for as long as no rule subtracts. Kept separate so a spending sink
  /// can arrive without a migration; the UI renders lifetime.
  balance        Int @default(0)
  lifetimePoints Int @default(0) @map("lifetime_points")

  /// Consecutive calendar days with a completed focus session — the streak the UI displays.
  currentDayStreak Int @default(0) @map("current_day_streak")
  longestDayStreak Int @default(0) @map("longest_day_streak")

  /// Consecutive completed focus sessions. Internal to the economy: it fires the +50 every third
  /// session and resets on a termination. Never displayed as "your streak".
  currentSessionRun Int @default(0) @map("current_session_run") @db.SmallInt

  /// The user-local date of the last completed focus session. Drives lazy streak resolution, so no
  /// scheduled job is needed to expire a streak.
  lastActiveDate DateTime? @map("last_active_date") @db.Date

  /// Ships with a value that nothing reads yet, so the freeze feature is later pure logic.
  streakFreezesAvailable Int       @default(1) @map("streak_freezes_available") @db.SmallInt
  lastFreezeGrantedOn    DateTime? @map("last_freeze_granted_on") @db.Date

  unlockedTitles String[] @default([]) @map("unlocked_titles")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_gamification")
}

/// A user's standing answer to "would you like reports by email?" (CONTRACT.md §23.1).
///
/// ONE ROW MEANS THE QUESTION HAS BEEN ANSWERED. Its absence means it never has, and the two are
/// kept apart deliberately: `declined` is an answer, no row is silence, and only telling them apart
/// lets the one-time invitation know whether it has already had its turn (§23.0 consequence 3). A
/// Google-created account has no row until it opens Settings, because the OAuth callback has no form
/// to answer.
///
/// `status` is 'pending_confirmation' | 'active' | 'paused' | 'declined' | 'unsubscribed' |
/// 'bounced', pinned by a CHECK constraint — VarChar rather than a Prisma enum, matching this
/// schema's existing refusal elsewhere. `declined` and `unsubscribed` both mean "off" and are
/// separate on purpose: one is an answer given before anything was sent, the other is an answer
/// given by somebody who was receiving reports and stopped.
///
/// THERE IS NO TIMEZONE COLUMN, AND THAT IS LOAD-BEARING. `users.timezone` is the single
/// interpretation key (§1.3) — write-once at signup, and the value every `focus_sessions`
/// `attribution_date` was already decided against. A second copy here could drift from it, and a
/// report bucketed one way while the app buckets another is the one defect this feature cannot
/// explain away. Periods and delivery times read the user row (§23.0 consequence 1).
model ReportSubscription {
  id     String @id @default(uuid(7)) @db.Uuid
  /// One subscription per account. Unique rather than the primary key so `report_deliveries` has a
  /// stable id to reference that survives the user re-subscribing.
  userId String @unique @map("user_id") @db.Uuid

  /// Retained while switched off, so re-enabling restores the previous answer rather than asking
  /// again. Meaningless while `status` is declined, unsubscribed, or bounced — read it with the
  /// status, never alone.
  frequency String @db.VarChar(16)
  status    String @db.VarChar(24)

  /// 1 = Monday … 7 = Sunday, for weekly subscriptions. Ignored by monthly ones, which are always
  /// the 1st. Read by the worker's selection query, which is what stops it being a column nobody
  /// consumes.
  deliveryDay Int @default(1) @map("delivery_day") @db.SmallInt

  /// Set by the soft-bounce rule (§25.6). `status` is the authority on whether reports are paused;
  /// this is only when the pause may lift.
  pausedUntil DateTime? @map("paused_until") @db.Timestamptz(3)

  /// Non-null once the address has ever been confirmed. Not cleared by unsubscribing — the address
  /// stayed proven, so re-subscribing later does not have to prove it twice.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)

  /// SHA-256 of the outstanding confirmation token, or null when none is (§23.3). Single-use:
  /// confirming clears it in the same statement that sets `status = 'active'`.
  confirmationTokenHash String?   @map("confirmation_token_hash") @db.VarChar(64)
  confirmationExpiresAt DateTime? @map("confirmation_expires_at") @db.Timestamptz(3)

  /// SHA-256 of the unsubscribe token. Long-lived and deliberately not expiring — an unsubscribe
  /// link in a year-old email that had stopped working would be a link that lied.
  unsubscribeTokenHash String @map("unsubscribe_token_hash") @db.VarChar(64)

  /// Reset to zero by any successful delivery. At SOFT_BOUNCE_LIMIT the subscription pauses.
  consecutiveSoftBounces Int       @default(0) @map("consecutive_soft_bounces") @db.SmallInt
  lastBounceAt           DateTime? @map("last_bounce_at") @db.Timestamptz(3)

  /// The cheap read for "have we already covered this period?". `report_deliveries` remains the
  /// authority — this is a denormalisation for the selection query, not a second source of truth.
  lastDeliveredPeriodStart DateTime? @map("last_delivered_period_start") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ReportDelivery[]

  /// Exactly the shape of the worker's hourly selection: the deliverable statuses, then the
  /// frequency, then the day that decides whether this is the account's morning.
  @@index([status, frequency, deliveryDay])
  @@map("report_subscriptions")
}

/// One attempt at one period — the delivery ledger (CONTRACT.md §23.2).
///
/// THE UNIQUE CONSTRAINT IS THE IDEMPOTENCY DESIGN (A7). With no queue, the worker's safety comes
/// from the database: a second tick inside the same hour finds this row and does nothing, so a cron
/// provider that fires twice, or a deploy that overlaps a run, cannot mail the same report twice.
///
/// A row is written BEFORE the document is rendered, not after. A crash mid-render then leaves a
/// `pending` row the next tick can see and retry, rather than no evidence that anything was started.
///
/// `status` is 'pending' | 'sent' | 'failed' | 'retryable' | 'skipped_empty' | 'abandoned', pinned
/// by a CHECK constraint. `skipped_empty` is a real outcome, not a failure: a period with no focus
/// sessions is not sent at all (P7), and recording the decision is what stops the next tick
/// reconsidering it.
model ReportDelivery {
  id             String @id @default(uuid(7)) @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid

  periodKind String @map("period_kind") @db.VarChar(16)

  /// User-local dates, both ends inclusive. Dates rather than instants because a period is a run of
  /// calendar days in the account's zone, and a DST day is 23 or 25 hours long (§24.2).
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  status   String @db.VarChar(16)
  attempts Int    @default(0) @db.SmallInt

  /// Null unless `status` is 'retryable'. The tick is the retry clock — nothing can run sooner than
  /// the next hourly pass, which is why the tick is hourly even for a weekly report (§26.3).
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)

  /// The provider's id for the accepted message, and the join key a bounce webhook arrives on.
  providerMessageId String? @map("provider_message_id") @db.VarChar(255)

  /// The provider's own words, truncated. Operational only: it is returned by no endpoint and
  /// rendered to no user, because it can quote an address or a provider-internal reason.
  lastError String? @map("last_error") @db.VarChar(500)

  /// The cut-off stamped into the document's footer. A period is frozen at generation and no later
  /// arrival restates it, so this is the honest answer to "as of when?" (§24.3).
  generatedAt DateTime? @map("generated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription ReportSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// A7. One attempt row per period per subscription, enforced by Postgres rather than by the
  /// worker remembering to check.
  @@unique([subscriptionId, periodKind, periodStart])
  /// The retry pass.
  @@index([status, nextAttemptAt])
  @@map("report_deliveries")
}

/// One provider webhook event, recorded so it is processed at most once (CONTRACT.md §25.6).
///
/// WHY A TABLE RATHER THAN RELYING ON IDEMPOTENT EFFECTS. Most of the effects are naturally
/// idempotent — setting a subscription to `bounced` twice is the same as once — but the soft-bounce
/// rule COUNTS, and a provider that retries its webhook (all of them do) would pause a healthy
/// subscription after one transient bounce delivered three times. The counter is the reason this
/// exists.
///
/// `event_id` is the provider's own message id from the signature header, which is unique per event
/// and stable across its retries. The insert is the claim: the writer that loses the unique index
/// knows the event is already handled.
model ReportWebhookEvent {
  id      String @id @default(uuid(7)) @db.Uuid
  eventId String @unique @map("event_id") @db.VarChar(255)

